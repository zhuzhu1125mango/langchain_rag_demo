# =============== Auto detect text files ===============
* text=auto eol=lf

# =============== Source code ===============
*.py text eol=lf diff=python
*.pyi text eol=lf diff=python
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# =============== Web frontend ===============
*.vue text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.html text eol=lf diff=html
*.css text eol=lf diff=css
*.scss text eol=lf
*.less text eol=lf

# =============== Config / Data ===============
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.env* text eol=lf
*.sql text eol=lf
*.xml text eol=lf

# =============== Documentation ===============
*.md text eol=lf diff=markdown
*.txt text eol=lf
LICENSE text eol=lf

# =============== Docker ===============
Dockerfile text eol=lf
*.dockerignore text eol=lf
docker-compose*.yml text eol=lf

# =============== Binary files ===============
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.tar binary
*.gz binary
*.rar binary
*.7z binary
