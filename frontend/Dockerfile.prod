# 生产环境镜像（多阶段构建）
# 阶段一 build：基于 node:20-alpine，安装 pnpm 与依赖，执行 pnpm run build 产出静态资源到 dist。
# 阶段二运行：基于 nginxinc/nginx-unprivileged:alpine（W6 #60 非 root 运行，监听 8080），
# 将 build 阶段的 dist 拷贝到 nginx html 目录，覆盖 nginx.conf 后以非 daemon 模式运行；
# HEALTHCHECK 探测本机静态首页，异常容器由编排层重启策略接管。
FROM node:20-alpine AS build

WORKDIR /app

RUN npm install -g pnpm

COPY package*.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install

COPY . .
RUN pnpm run build

FROM nginxinc/nginx-unprivileged:alpine

COPY --from=build /app/dist /usr/share/nginx/html

COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
