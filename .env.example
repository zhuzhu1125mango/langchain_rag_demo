# ============================================================
# LangChain RAG Demo 环境变量模板
# 复制本文件为 .env / .env.dev / .env.prod 后按需修改
# 注意：.env* 文件不会被提交到 Git，请勿在此存放生产密钥
# ============================================================

# 数据库（PostgreSQL）
POSTGRES_DB=app_dev                       # 初始化数据库名
POSTGRES_USER=dev_user                    # 数据库用户名
POSTGRES_PASSWORD=change_me_in_production # 数据库密码（生产环境必填强密码）
POSTGRES_HOST=localhost                   # 数据库主机（容器内为 postgres）
POSTGRES_PORT=5433                        # 数据库端口（容器内为 5432）

# 对象存储（MinIO）
MINIO_ROOT_USER=dev_minio                 # MinIO 管理员账号
MINIO_ROOT_PASSWORD=change_me_in_production  # MinIO 管理员密码（生产环境必填强密码）
MINIO_ACCESS_KEY=dev_access_key           # 业务访问 MinIO 的 access key
MINIO_SECRET_KEY=change_me_in_production  # 业务访问 MinIO 的 secret（生产环境必填强密钥）
MINIO_BUCKET_NAME=documents               # 文档存储 bucket 名称
MINIO_ENDPOINT=localhost:9000             # MinIO 服务地址
MINIO_SECURE=false                        # 是否启用 HTTPS

# 向量数据库（Milvus）
MILVUS_HOST=localhost                     # Milvus 主机（容器内为 milvus-standalone）
MILVUS_PORT=19530                         # Milvus gRPC 端口
MILVUS_DATABASE=default                   # Milvus 数据库实例
MILVUS_COLLECTION_NAME=documents          # 向量集合名
MILVUS_INDEX_NAME=document_index          # 向量索引名

# 本地模型（Ollama）
OLLAMA_MODEL_NAME=deepseek-r1:7b-qwen-distill-q4_K_M  # 对话使用的大模型
EMBEDDING_MODEL_NAME=nomic-embed-text:latest          # 向量化使用的模型

# 文档处理
CHUNK_SIZE=512                            # 文档分块大小（字符）
CHUNK_OVERLAP=64                          # 文档分块重叠字符数
TOP_K=3                                   # 检索召回数量

# 缓存（Redis）
REDIS_HOST=localhost                      # Redis 主机（容器内为 redis）
REDIS_DB=0                                # Redis 逻辑库编号
REDIS_PASSWORD=                           # Redis 密码（生产环境建议设置）

# 安全密钥：生产环境必须设置为强随机密钥，否则服务可能无法启动
SECRET_KEY=change_me_to_a_strong_random_key  # 应用签名密钥（JWT/Session）

# Grafana 管理员密码
GF_SECURITY_ADMIN_PASSWORD=admin          # Grafana 登录密码（生产环境必填强密码）

# ============================================================
# 联网搜索配置
# ============================================================
SEARCH_PROVIDER=searxng                   # 搜索引擎提供方（searxng/tavily 等）
SEARXNG_BASE_URL=http://localhost:8080    # SearXNG 服务地址
# SearXNG 服务密钥（生产环境必须修改为强随机字符串）
SEARXNG_SECRET_KEY=change-me-in-production  # SearXNG 会话加密密钥
SEARCH_MAX_RESULTS=10                     # 单次搜索最大结果数
SEARCH_FETCH_TIMEOUT=10                   # 抓取网页超时（秒）
SEARCH_MAX_FETCH=5                        # 单次搜索最多抓取网页数
SEARCH_MIN_CONTENT_LENGTH=100             # 内容最小长度过滤（字符）
SEARXNG_TIMEOUT=10                        # SearXNG 请求超时（秒）

# Phase 2：Query 改写 / 重排 / 缓存
SEARCH_ENABLE_MULTI_QUERY=true            # 启用多查询改写
SEARCH_NUM_QUERIES=3                      # 改写查询数量
SEARCH_ENABLE_RERANK=true                 # 启用结果重排
SEARCH_RERANK_MODEL=BAAI/bge-reranker-base  # 重排模型
SEARCH_RERANK_TOP_K=5                     # 重排后保留数量
SEARCH_CACHE_TTL=3600                     # 搜索结果缓存 TTL（秒）
SEARCH_CONTENT_CACHE_TTL=86400            # 抓取内容缓存 TTL（秒）

# Phase 3：Function Calling / ReAct Agent
SEARCH_ENABLE_FUNCTION_CALLING=false      # 启用 Function Calling 搜索
SEARCH_ENABLE_REACT=false                 # 启用 ReAct Agent 搜索
SEARCH_REACT_MAX_STEPS=3                  # ReAct 最大推理步数
SEARCH_AGENT_FALLBACK_TO_PHASE2=true      # Agent 失败时回退到 Phase 2

# 会话标题自动生成（基于 LLM）
TITLE_GENERATION_ENABLED=true             # 启用会话标题自动生成
TITLE_MAX_LENGTH=30                       # 标题最大字符数
TITLE_FALLBACK_LENGTH=30                  # 生成失败时回退标题长度
# 留空则默认使用 OLLAMA_MODEL_NAME
TITLE_GENERATION_MODEL=                   # 标题生成使用的模型
