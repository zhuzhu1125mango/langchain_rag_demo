# ============================================================
# LangChain RAG Demo 环境变量模板
# 复制本文件为 .env / .env.dev / .env.prod 后按需修改
# 注意：.env* 文件不会被提交到 Git，请勿在此存放生产密钥
# ============================================================

# 数据库（PostgreSQL）
POSTGRES_DB=app_dev                       # 初始化数据库名
POSTGRES_USER=dev_user                    # 数据库用户名
POSTGRES_PASSWORD=change_me_in_production # 数据库密码（生产环境必填强密码）
POSTGRES_HOST=localhost                   # 数据库主机（容器内为 postgres）
POSTGRES_PORT=5433                        # 数据库端口（容器内为 5432）
SQL_ECHO=False                            # SQLAlchemy SQL 回显（开发可设 True，生产保持 False）

# 对象存储（MinIO）
MINIO_ROOT_USER=dev_minio                 # MinIO 管理员账号
MINIO_ROOT_PASSWORD=change_me_in_production  # MinIO 管理员密码（生产环境必填强密码）
MINIO_ACCESS_KEY=dev_access_key           # 业务访问 MinIO 的 access key
MINIO_SECRET_KEY=change_me_in_production  # 业务访问 MinIO 的 secret（生产环境必填强密钥）
MINIO_BUCKET_NAME=documents               # 文档存储 bucket 名称
MINIO_ENDPOINT=localhost:9000             # MinIO 服务地址
MINIO_SECURE=false                        # 是否启用 HTTPS

# 向量数据库（Milvus）
MILVUS_HOST=localhost                     # Milvus 主机（容器内为 milvus-standalone）
MILVUS_PORT=19530                         # Milvus gRPC 端口
MILVUS_DATABASE=default                   # Milvus 数据库实例
MILVUS_COLLECTION_NAME=documents          # 向量集合名
MILVUS_INDEX_NAME=document_index          # 向量索引名
MILVUS_HNSW_M=16                          # HNSW 图连通度参数
MILVUS_EF_CONSTRUCTION=128                # HNSW 建索引搜索范围
MILVUS_EF=128                             # HNSW 检索搜索范围
MILVUS_REBUILD_ON_MISMATCH=false          # 集合 schema/维度不匹配时是否删除重建（破坏性！旧向量数据全部丢失，默认禁止并启动失败）
# MILVUS_BM25_VOCAB_DIR=                  # BM25 sparse 词表持久化目录，留空使用 backend/src/data/bm25（词表与 collection 绑定，重启自动加载）

# 本地模型（Ollama）
OLLAMA_MODEL_NAME=deepseek-r1:7b-qwen-distill-q4_K_M  # 对话/RAG 最终答案使用的大模型（重推理）
EMBEDDING_MODEL_NAME=bge-m3:latest                    # 向量化使用的模型（bge-m3 为 1024 维）
EMBEDDING_DIMENSION=1024                              # 需与 EMBEDDING_MODEL_NAME 对应
FAST_LLM_MODEL_NAME=qwen2.5:7b                        # 意图路由/标题生成/Query改写等轻量任务
# OLLAMA_HOST=http://localhost:11434                  # Ollama 服务地址，默认使用 ollama 包默认值

# 文档处理
CHUNK_SIZE=512                            # 文档分块大小（字符）
CHUNK_OVERLAP=64                          # 文档分块重叠字符数
TOP_K=3                                   # 检索召回数量
MAX_UPLOAD_SIZE_MB=100                    # 单文件上传大小上限（MB），服务端按实测字节数校验

# 阶段一：知识库混合检索（dense + BM25 + RRF + rerank）
KB_ENABLE_HYBRID_SEARCH=true              # 是否启用混合检索
KB_HYBRID_SEARCH_TOP_K=20                 # 各路检索召回数量
KB_HYBRID_RERANK_TOP_K=5                  # 重排序后保留数量
KB_RRF_K=60                               # RRF 融合平滑因子
KB_RERANK_MIN_SCORE=0.0                   # 重排序最低置信度过滤
KB_RERANK_MODEL=qllama/bge-reranker-v2-m3:latest  # 知识库重排序模型
KB_RERANK_PROVIDER=ollama                 # 重排序模型加载方式：sentence_transformers | ollama
CONTEXT_TOKEN_BUDGET=4000                 # 上下文 token 预算
CONTEXT_COMPRESSION_ENABLED=false         # 是否启用上下文压缩

# 缓存（Redis）
REDIS_HOST=localhost                      # Redis 主机（容器内为 redis）
REDIS_DB=0                                # Redis 逻辑库编号
REDIS_PASSWORD=dev_redis_password         # Redis 密码（必填，生产环境必须设置为强密码）

# 安全密钥：应用签名密钥（JWT/Session），生产环境必须设置为强随机密钥
# 要求：长度 >= 32，包含至少 3 种字符类型（大写、小写、数字、特殊字符），且不在弱密钥黑名单
# 生产环境必须取消下面一行的注释并填入强随机值
# SECRET_KEY=

# 显式环境标记：dev | production
# 非 Docker 的生产部署（直接 uvicorn/systemd 运行）必须设置 APP_ENV=production，
# 否则启动时不会强制执行密钥强度/凭据非空校验；Docker 部署无需设置（由 IN_DOCKER 推断）
# APP_ENV=dev

# 全局 API Key（自托管单实例认证）：生产环境必须设置为强随机字符串
# 前端和所有 API 调用都需要在请求头中携带 X-API-Key
# 生产环境必须取消下面一行的注释并填入强随机值
# API_KEY=

# 管理操作密钥（全局配置修改 /config/processing、/config/reset、/metrics/reset）
# 请求须携带 X-Admin-Key 头且与该值匹配；生产模式未设置时管理接口一律 403
# ADMIN_KEY=

# Grafana 管理员密码
GF_SECURITY_ADMIN_PASSWORD=admin          # Grafana 登录密码（生产环境必填强密码）

# ============================================================
# 联网搜索配置
# ============================================================
SEARCH_PROVIDER=searxng                   # 搜索引擎提供方（searxng/tavily 等）
SEARXNG_BASE_URL=http://localhost:8080    # SearXNG 服务地址
# SearXNG 服务密钥（生产环境必须修改为强随机字符串）
SEARXNG_SECRET_KEY=change-me-in-production  # SearXNG 会话加密密钥
SEARCH_MAX_RESULTS=10                     # 单次搜索最大结果数
SEARCH_FETCH_TIMEOUT=10                   # 抓取网页超时（秒）
SEARCH_MAX_FETCH=5                        # 单次搜索最多抓取网页数
SEARCH_MIN_CONTENT_LENGTH=100             # 内容最小长度过滤（字符）
SEARXNG_TIMEOUT=10                        # SearXNG 请求超时（秒）

# Phase 2：Query 改写 / 重排 / 缓存
SEARCH_ENABLE_MULTI_QUERY=true            # 启用多查询改写
SEARCH_NUM_QUERIES=3                      # 改写查询数量
SEARCH_ENABLE_RERANK=true                 # 启用结果重排
SEARCH_RERANK_MODEL=qllama/bge-reranker-v2-m3:latest  # 重排模型
SEARCH_RERANK_PROVIDER=ollama             # 重排序模型加载方式：sentence_transformers | ollama
SEARCH_RERANK_TOP_K=5                     # 重排后保留数量
SEARCH_CACHE_TTL=3600                     # 搜索结果缓存 TTL（秒）
SEARCH_CONTENT_CACHE_TTL=86400            # 抓取内容缓存 TTL（秒）

# Phase 3：Function Calling / ReAct Agent
SEARCH_ENABLE_FUNCTION_CALLING=true             # 启用 Function Calling 搜索
SEARCH_ENABLE_REACT=false                 # 启用 ReAct Agent 搜索
SEARCH_REACT_MAX_STEPS=3                  # ReAct 最大推理步数
SEARCH_AGENT_FALLBACK_TO_PHASE2=true      # Agent 失败时回退到 Phase 2

# 会话标题自动生成（基于 LLM）
TITLE_GENERATION_ENABLED=true             # 启用会话标题自动生成
TITLE_MAX_LENGTH=30                       # 标题最大字符数
TITLE_FALLBACK_LENGTH=30                  # 生成失败时回退标题长度
# 标题生成模型，留空则默认使用 FAST_LLM_MODEL_NAME
TITLE_GENERATION_MODEL=

# ============================================================
# 阶段二：意图路由升级（规则 + LLM 语义 + 置信度门控）
# ============================================================
INTENT_ROUTER_USE_LLM=true                # 是否启用 LLM 语义路由层
INTENT_ROUTER_LLM_TIMEOUT=3.0             # LLM 路由超时时间（秒）
INTENT_ROUTER_CONFIDENCE_THRESHOLD=0.4    # 最低置信度阈值
INTENT_ROUTER_AMBIGUITY_GAP=0.15          # 意图歧义分差阈值
# 意图路由使用的模型，留空则默认使用 FAST_LLM_MODEL_NAME
INTENT_ROUTER_LLM_MODEL=
INTENT_ROUTER_MAX_HISTORY_TURNS=5         # LLM 路由参考的最大历史轮数
INTENT_ROUTER_RULE_CONFLICT_DETECTION=true # 是否启用规则冲突检测

# Query 改写（基于 LLM fallback）
# Query 改写使用的模型，留空则默认使用 FAST_LLM_MODEL_NAME
QUERY_REWRITE_MODEL=

# ============================================================
# 阶段三：检索/生成评估与 Badcase 闭环
# ============================================================
EVALUATION_ENABLED=true                         # 是否启用 RAG 链路自动评估
EVALUATION_RETRIEVAL_SIMILARITY_THRESHOLD=0.6   # 检索评估 embedding 相似度阈值
# 生成评估 LLM-as-judge 使用的模型，留空则默认使用 FAST_LLM_MODEL_NAME
EVALUATION_JUDGE_MODEL=
EVALUATION_FAITHFULNESS_LOW=0.4                 # 忠实度低分阈值
EVALUATION_RELEVANCE_LOW=0.4                    # 相关度低分阈值
