# =============================================================================
# 后端开发环境 Dockerfile
# -----------------------------------------------------------------------------
# 基础镜像：python:3.12-slim（精简版，体积小）
# 特点：安装全部依赖（含开发依赖），uvicorn 启动时启用 --reload 热重载，
#       源码通过 docker-compose 卷挂载，无需在镜像中固化代码变更。
# =============================================================================
FROM python:3.12-slim

WORKDIR /app

# 安装系统依赖（build-essential/gcc 用于编译 Python 扩展，curl 用于健康检查）
# 先将 Debian 官方源替换为清华镜像源（规避代理/网络导致的 404）
RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g; s|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv（直接从官方镜像复制二进制，无需容器内 pip 下载）
# pypi 源已在 pyproject.toml/uv.lock 中锁定为清华镜像，无需环境变量
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# 复制依赖清单（利用 Docker 缓存层，依赖不变时跳过后续安装）
COPY pyproject.toml uv.lock ./

# 同步依赖（--frozen 严格按锁文件；默认含 dev 组，供开发环境 pytest 等使用）
RUN uv sync --frozen

ENV PATH="/app/.venv/bin:$PATH"

# 复制项目代码（开发环境主要靠卷挂载，此处复制保证镜像可独立运行）
COPY . .

ENV PYTHONPATH=/app

EXPOSE 8000

# 健康检查：每 30s 探测 /health 端点
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 启动命令：uvicorn 启动 FastAPI 应用，--reload 启用热重载
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
