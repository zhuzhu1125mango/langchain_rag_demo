# =============================================================================
# 后端生产环境 Dockerfile
# -----------------------------------------------------------------------------
# 基础镜像：python:3.12-slim（精简版，体积小）
# 特点：跳过开发依赖以减小镜像体积，uvicorn 不启用 --reload（生产无需热重载）。
# =============================================================================
FROM python:3.12-slim

WORKDIR /app

# 安装系统依赖（g++ 用于编译 C++ 扩展，curl 用于健康检查）
# 先将 Debian 官方源替换为清华镜像源（规避代理/网络导致的 404）
RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g; s|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv（直接从官方镜像复制二进制，无需容器内 pip 下载）
# pypi 源已在 pyproject.toml/uv.lock 中锁定为清华镜像，无需环境变量
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# 复制依赖清单（利用 Docker 缓存层，依赖不变时跳过后续安装）
COPY pyproject.toml uv.lock ./

# 同步依赖（生产环境跳过开发依赖以减小镜像体积）
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH"

# 复制项目代码
COPY . .

ENV PYTHONPATH=/app

EXPOSE 8000

# 健康检查：每 30s 探测 /health 端点
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 启动命令：uvicorn 启动 FastAPI 应用（生产环境不启用 --reload）
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
