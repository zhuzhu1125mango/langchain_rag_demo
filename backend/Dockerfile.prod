# =============================================================================
# 后端生产环境 Dockerfile
# -----------------------------------------------------------------------------
# 基础镜像：python:3.12-slim（精简版，体积小）
# 特点：跳过开发依赖以减小镜像体积，uvicorn 不启用 --reload（生产无需热重载）。
# =============================================================================
FROM python:3.12-slim

WORKDIR /app

# 安装系统依赖（g++ 用于编译 C++ 扩展，curl 用于健康检查）
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 Poetry（依赖管理工具，锁定版本 2.1.3）
RUN pip install --no-cache-dir poetry==2.1.3

# 配置 Poetry：在容器中不创建虚拟环境（直接安装到系统 Python）
RUN poetry config virtualenvs.create false

# 复制 Poetry 配置文件（利用 Docker 缓存层，依赖不变时跳过后续安装）
COPY pyproject.toml poetry.lock* ./

# 安装依赖（生产环境跳过开发依赖以减小镜像体积）
RUN poetry install --no-interaction --no-ansi --no-root --without dev

# 复制项目代码
COPY . .

ENV PYTHONPATH=/app

EXPOSE 8000

# 健康检查：每 30s 探测 /health 端点
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 启动命令：uvicorn 启动 FastAPI 应用（生产环境不启用 --reload）
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
