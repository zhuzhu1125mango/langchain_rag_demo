# =============================================================================
# 后端生产环境 Dockerfile（多阶段构建）
# -----------------------------------------------------------------------------
# 构建阶段：拉取依赖并编译（build-essential/gcc/g++ 等编译工具，不出现在运行镜像）。
# 运行阶段：仅含运行时所需资源，以非 root 用户运行，压缩体积与攻击面。
# uv 版本钉死（避免 :latest 漂移导致构建不可复现），pypi 源已在
# pyproject.toml/uv.lock 中锁定为清华镜像，无需环境变量。
# =============================================================================

# --- 构建阶段 ---
FROM python:3.12-slim AS builder

WORKDIR /app

# 安装编译工具（构建 .venv 时可能编译 C/C++ 扩展；仅存在于本阶段）
# 先将 Debian 官方源替换为清华镜像源（规避代理/网络导致的 404）
RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g; s|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv（钉版本）
COPY --from=ghcr.io/astral-sh/uv:0.6.3 /uv /usr/local/bin/uv

# 复制依赖清单（利用 Docker 缓存层，依赖不变时跳过后续安装）
COPY pyproject.toml uv.lock ./

# 同步依赖（生产环境跳过开发依赖以减小镜像体积）
RUN uv sync --frozen --no-dev

# --- 运行阶段 ---
FROM python:3.12-slim

WORKDIR /app

# 仅安装运行时所需的 curl（健康检查），不再安装编译工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 从构建阶段拷贝 uv 与已编译的虚拟环境
COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv
COPY --from=builder /app/.venv /app/.venv

ENV PATH="/app/.venv/bin:$PATH"

# 以非 root 用户运行：创建专用用户并赋予 /app 数据目录写权限，
# 降低镜像被攻破后对宿主权限的获取面
RUN useradd --create-home --user-group appuser \
    && mkdir -p /app/data /app/logs \
    && chown -R appuser:appuser /app
USER appuser

# 复制项目代码（归属 appuser）
COPY --chown=appuser:appuser . .

ENV PYTHONPATH=/app

EXPOSE 8000

# 健康检查：每 30s 探测 /health 端点
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 启动命令：uvicorn 启动 FastAPI 应用（生产环境不启用 --reload）
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]